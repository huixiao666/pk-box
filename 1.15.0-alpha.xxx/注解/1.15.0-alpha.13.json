        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/{tag}.srs", // URL 模板：{tag} 会被替换为上面列表中的每个标签，从而批量下载对应的 .srs 文件
        "http_client": "rule-set-dl", // 使用之前定义的 rule-set-dl HTTP 客户端下载；该客户端走代理，提高 GitHub/jsDelivr 的可达性
        "update_interval": "48h0m0s" // 规则集更新间隔为 48 小时，即每两天重新下载一次，平衡时效性与流量消耗
      }, // 规则集组 1 结束

