      ], // outbounds 结束
      "default": "📦 sing-box" // 默认使用“📦 sing-box”
    }, // GLOBAL 结束

    { // 最终兜底选择器
      "type": "selector", // 选择器类型
      "tag": "🚦 FINAL", // 标签为“🚦 FINAL”
      "outbounds": [ // 可选出口
        "📦 sing-box", // 主代理选择器
        "DIRECT", // 直连
        "❌ REJECT-DROP" // 拒绝/丢弃出站
