        "udp_disable_domain_unmapping": true, // 对 UDP 连接禁用“域名解除映射”行为：保留 UDP 响应中的域名信息，不将其替换为 IP，有助于某些依赖域名信息的协议[reference:24]
        "udp_connect": true // 对 UDP 使用 connected socket（连接式 UDP），可提高性能和某些场景下的兼容性[reference:25]
