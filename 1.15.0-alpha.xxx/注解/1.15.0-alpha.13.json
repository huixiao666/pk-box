{ // 配置文件的根对象，sing-box 所有配置均包裹在这一层大括号内

  "log": { // 日志模块：控制日志级别、时间戳等输出行为
    "level": "trace", // 日志级别设为 trace，会输出最详细的调试信息（含内部状态、DNS 竞速过程），适合排查问题；日常稳定使用可改为 info 或 warn 以减少日志量
    "timestamp": true // 在每条日志前附加时间戳，便于对照事件发生顺序（尤其在调试 DNS race 和路由匹配时非常有用）
  }, // log 模块结束

  "dns": { // DNS 模块：定义 DNS 服务器、DNS 规则以及 DNS 缓存行为
    "servers": [ // DNS 服务器列表，每个元素声明一个可用于解析的 DNS 后端

      { // 第 1 个 DNS 服务器：hosts 类型，用于静态域名映射（bootstrap）
        "type": "hosts", // 服务器类型为 hosts，不从网络查询，而是直接返回 predefined 中预设的 IP
        "tag": "hosts_fix", // 该服务器的标签为 hosts_fix，后续 server 或 domain_resolver 字段通过这个标签引用它
        "predefined": { // 静态映射表：键是域名，值是直接返回的 IP 列表
          "cloudflare-dns.com": [ // 为 cloudflare-dns.com 预设 IP，避免解析这个 DoH 服务器域名时产生循环依赖
            "1.1.1.1", // Cloudflare 主 DNS 的 IPv4 地址
            "1.0.0.1" // Cloudflare 备用 DNS 的 IPv4 地址
          ], // cloudflare-dns.com 映射结束
          "dns.google": [ // 为 dns.google 预设 IP，理由同上：DoH 服务器域名不能再用 DoH 去解析自身
            "8.8.8.8", // Google 主 DNS 的 IPv4 地址
            "8.8.4.4" // Google 备用 DNS 的 IPv4 地址
          ], // dns.google 映射结束
          "raw.githubusercontent.com": [ // 为 GitHub raw 域名预设 IP，确保规则集下载不被 DNS 解析阻塞或污染
            "185.199.108.133", // GitHub raw 的 IPv4 地址之一
            "185.199.109.133", // GitHub raw 的 IPv4 地址之一
            "185.199.110.133", // GitHub raw 的 IPv4 地址之一
            "185.199.111.133" // GitHub raw 的 IPv4 地址之一
          ] // raw.githubusercontent.com 映射结束
        } // predefined 静态映射表结束
      }, // hosts_fix 服务器定义结束

      { // 第 2 个 DNS 服务器：local 类型，使用系统本地解析器
        "type": "local", // 类型为 local，调用操作系统提供的 DNS 解析（在 Android 上通常是系统 DNS 或 netd 解析器）
        "tag": "pkpk-dns" // 标签为 pkpk-dns，后续国内域名、华为域名、微软/苹果中国域名等规则会指向这个服务器，实现“国内域名用本地 DNS 解析”的分流
      }, // pkpk-dns 服务器定义结束

      { // 第 3 个 DNS 服务器：https 类型（DoH），通过代理出口访问 Cloudflare DNS
        "type": "https", // 类型为 https，表示使用 DNS over HTTPS（DoH）协议进行查询[reference:3]
        "tag": "cf-dns", // 标签为 cf-dns，供 DNS 规则和 final 字段引用
        "detour": "📦 sing-box", // 指定 DNS 查询流量从出站选择器“📦 sing-box”走代理，防止 DNS 泄漏并规避网络干扰；DNS 模块的 detour 用于指定该 DoH 请求从哪个出站发出
        "domain_resolver": "hosts_fix", // 指定解析 cloudflare-dns.com 这个域名时使用的解析器为 hosts_fix；因为 DoH 服务器本身也是域名，必须先解析它，这里用 hosts 静态解析避免自举循环[reference:5]
        "server": "cloudflare-dns.com" // 实际的 DoH 端点域名；sing-box 会自动构造 https://cloudflare-dns.com/dns-query 形式的请求
      }, // cf-dns 服务器定义结束

      { // 第 4 个 DNS 服务器：https 类型（DoH），通过代理出口访问 Google DNS
        "type": "https", // 同样是 DoH 类型
        "tag": "google-dns", // 标签为 google-dns，供 Google 相关域名的 DNS 规则引用
        "detour": "📦 sing-box", // 查询流量同样走“📦 sing-box”代理选择器，避免直连暴露或受干扰
        "domain_resolver": "hosts_fix", // 用 hosts_fix 静态解析 dns.google 域名，避免 DoH 自举时的额外解析和潜在环路
        "server": "dns.google" // Google DoH 的端点域名
      } // google-dns 服务器定义结束

    ], // DNS 服务器列表结束

    "rules": [ // DNS 规则列表：按顺序匹配，决定一个 DNS 查询交给哪个服务器处理，或执行特殊动作

      { // 规则 1：将 Google、Google FCM、Android 相关域名交给 google-dns 解析
        "rule_set": [ // 匹配条件为“命中以下任一规则集”
          "geosite-google", // sing-geosite 中的 Google 域名集合
          "geosite-googlefcm", // Google FCM（Firebase Cloud Messaging）推送相关域名集合
          "geosite-android", // Android 系统相关域名集合
        ], // rule_set 数组结束
        "server": "google-dns" // 动作：将匹配的 DNS 查询路由到 google-dns（DoH over 代理）进行解析
      }, // 规则 1 结束

      { // 规则 2：一批国内服务、华为系、B站、DeepSeek 等域名使用本地 DNS 解析
        "domain_suffix": [ // 匹配条件为“域名后缀命中以下任意一项”
          ".huawei.com", // 华为主域名后缀
          ".harmonyos.com", // HarmonyOS 相关域名后缀
          ".hicloud.com", // 华为云相关域名后缀
          ".vmall.com", // 华为商城域名后缀
          ".huaweicloud.com", // 华为云服务域名后缀
          ".hwclouds-dns.com", // 华为云 DNS 相关域名后缀
          ".dbankcloud.com", // 华为数据云相关域名后缀
          ".dbankcloud.cn", // 华为数据云国内域名后缀
          ".huawei.cn", // 华为中国域名后缀
          ".hwpan.com", // 华为网盘/云空间相关域名后缀
          ".honor.cn", // 荣耀中国域名后缀
          ".bilivideo.com", // B站视频 CDN 域名后缀
          ".bilibili.com", // B站主域名后缀
          ".biliapi.com", // B站 API 域名后缀
          ".hdslb.com", // B站静态资源 CDN 域名后缀
          ".biliimg.com", // B站图片 CDN 域名后缀
          ".acgvideo.com", // B站相关视频域名后缀
          ".deepseek.com", // DeepSeek 主域名后缀
          ".deepseek.chat" // DeepSeek 聊天服务域名后缀
        ], // domain_suffix 数组结束
        "server": "pkpk-dns" // 动作：使用 pkpk-dns（local 类型，系统解析器）解析这些国内域名，降低延迟并避免代理出口的 DNS 解析开销
      }, // 规则 2 结束

      { // 规则 3：微软中国、苹果中国、国内游戏、通用国内域名集合也交给本地 DNS
        "rule_set": [ // 匹配条件为“命中以下任一规则集”
          "microsoft-cn", // 微软中国相关域名集合
          "apple-cn", // 苹果中国相关域名集合
          "games-cn", // 国内游戏相关域名集合
          "cn" // 通用国内域名集合（来自 DustinWin 的 ruleset_geodata）
        ], // rule_set 数组结束
        "server": "pkpk-dns" // 同样使用本地 DNS 解析，与规则 2 共同构成“国内域名走本地 DNS”的策略
      }, // 规则 3 结束

      { // 规则 4：拒绝 PTR 查询（反向 DNS）
        "query_type": "PTR", // 匹配查询类型为 PTR 的 DNS 请求
        "action": "reject" // 动作：直接拒绝，不发起真实 DNS 查询；PTR 查询通常用于反向解析，在代理场景中往往无必要且可能泄漏信息或增加延迟
      }, // 规则 4 结束

      { // 规则 5：拦截广告类域名
        "rule_set": "geosite-category-ads-all", // 匹配 sing-geosite 中的广告类域名全集
        "action": "reject" // 动作：拒绝这些 DNS 查询，后续连接自然也无法建立，实现 DNS 层面的广告拦截
      }, // 规则 5 结束

      { // 规则 6：对前面未匹配的域名，先并发评估 cf-dns 的响应，并打上标签 "cf"
        "action": "evaluate", // 动作 evaluate：向指定服务器发起查询，但不立即终止规则遍历，而是将响应暂存并打上标签，供后面的 match_response 规则使用[reference:7][reference:8]
        "server": "cf-dns", // 被评估的 DNS 服务器：cf-dns（Cloudflare DoH）
        "tag": "cf" // 为这次 evaluate 产生的响应打上标签 "cf"，后面的 match_response 规则通过标签引用这个响应
      }, // 规则 6 结束

      { // 规则 7：同样地，并发评估 google-dns 的响应，并打上标签 "gg"
        "action": "evaluate", // 同样是 evaluate 动作，与规则 6 并行执行
        "server": "google-dns", // 被评估的 DNS 服务器：google-dns（Google DoH）
        "tag": "gg" // 响应标签为 "gg"
      }, // 规则 7 结束

      { // 规则 8：等待标签 "cf" 的响应，哪个先返回就使用哪个
        "match_response": "cf", // 匹配条件：引用前面 evaluate 打上 "cf" 标签的响应[reference:9]
        "action": "respond", // 动作 respond：使用这个已评估的响应直接作为最终 DNS 应答，并终止 DNS 规则遍历
        "race": true // race 为 true 时，规则 8 和规则 9 并行竞争：谁对应的 DoH 先返回且匹配，谁就立即生效，另一个查询会被取消；这是 1.14 引入的 DNS 并行竞速机制，用于降低首包 DNS 延迟[reference:10][reference:11]
      }, // 规则 8 结束

      { // 规则 9：等待标签 "gg" 的响应，与规则 8 并行竞争
        "match_response": "gg", // 引用 "gg" 标签的响应
        "action": "respond", // 使用该响应作为最终应答
        "race": true // 与规则 8 并行 race：Cloudflare 和 Google 谁的 DoH 先返回，就用谁，剩下的查询被丢弃
      } // 规则 9 结束

    ], // DNS 规则列表结束

    "final": "cf-dns", // DNS 最终兜底服务器：如果所有 DNS 规则都没有匹配（或没有 race 生效），则默认使用 cf-dns 解析
    "strategy": "ipv4_only", // DNS 解析策略为仅返回 IPv4 地址；在仅需要 IPv4 的场景下可减少 AAAA 查询开销和潜在问题
    "timeout": "5s", // 单次 DNS 查询的超时时间为 5 秒，超时后视为失败，避免长时间挂起
    "cache_capacity": 8192, // DNS 缓存容量上限为 8192 条记录，内存中的 DNS 缓存最多保存这么多条目
    "optimistic": { // 乐观 DNS 缓存配置（optimistic DNS cache）
      "enabled": true, // 启用乐观缓存：在缓存条目过期后，仍然先返回过期的旧记录，同时在后台刷新，以降低等待时间
      "timeout": "5m0s" // 乐观缓存的额外容忍时间为 5 分钟：过期后 5 分钟内仍可返回旧记录并在后台更新
    } // optimistic 配置结束

  }, // dns 模块结束

  "http_clients": [ // HTTP 客户端列表：用于远程规则集下载等 HTTP 请求的专用客户端配置

    { // 一个 HTTP 客户端定义
      "tag": "rule-set-dl", // 客户端标签为 rule-set-dl，供 route.rule_set 中的 http_client 字段引用
      "version": 2, // HTTP 客户端版本为 2；sing-box 中 version 2 通常对应更现代的实现（如基于标准库或特定传输），用于规则集下载
      "detour": "📦 sing-box" // 该 HTTP 客户端的流量从“📦 sing-box”出站走代理；因为规则集 URL 是 GitHub / jsDelivr，直连可能不稳定，走代理可提高下载成功率
    } // rule-set-dl 客户端定义结束

  ], // http_clients 列表结束

  "inbounds": [ // 入站列表：定义 sing-box 如何接收来自设备或网络的流量

    { // 唯一的入站：TUN 模式
      "type": "tun", // 入站类型为 tun，创建一个虚拟网卡来接管设备流量
      "tag": "tun-in", // 入站标签为 tun-in，供路由规则中的 inbound 字段引用（当前配置未显式使用 inbound 规则，但标签仍可用于日志和调试）
      "mtu": 1400, // TUN 接口的 MTU 设为 1400；在移动网络或代理封装场景下，适当降低 MTU 可减少分片，通常 1400 是一个兼顾性能与兼容性的值
      "address": "30.8.8.8/16", // 为 TUN 接口分配的 IPv4 地址及子网掩码；sing-box 会在此地址上响应 DNS 劫持等请求，/16 提供较大的地址空间
      "dns_mode": "hijack", // TUN 的 DNS 模式设为 hijack：拦截设备发往任意 DNS 服务器（通常是 53 端口）的查询，并转入 sing-box 内部 DNS 模块处理[reference:12][reference:13]
      "auto_route": true, // 自动路由：sing-box 会向系统路由表安装指向 TUN 设备的路由，使设备流量进入 TUN[reference:14]
      "strict_route": true, // 严格路由：启用更严格的路由绑定和平台级 DNS 劫持（在 Android 上配合 auto_route 可减少流量绕过 TUN 的情况）[reference:15]
      "route_exclude_address": [ // 路由排除地址列表：以下私有网段的流量不会进入 TUN，避免影响局域网访问
        "192.168.0.0/16", // 排除 192.168.0.0/16 私有地址段（家庭/企业局域网常用）
        "172.16.0.0/12", // 排除 172.16.0.0/12 私有地址段
        "10.0.0.0/8" // 排除 10.0.0.0/8 私有地址段
      ], // route_exclude_address 结束
      "udp_timeout": "30s", // UDP NAT 会话的超时时间为 30 秒；对于 DNS over UDP 等短会话，30 秒足以完成查询并回收资源
      "udp_nat_max": 4096 // UDP NAT 表最大条目数为 4096，限制并发 UDP 映射数量，防止内存过度占用
    } // tun-in 入站定义结束

  ], // inbounds 列表结束

  "outbounds": [ // 出站列表：定义流量可以被发送到哪些出口（代理、直连、选择器等）

    { // 直连出站
      "type": "direct", // 类型为 direct，流量直接从本地网络接口发出，不经过代理
      "tag": "DIRECT" // 标签为 DIRECT，供路由规则和选择器引用
    }, // DIRECT 出站结束

    { // 主代理选择器：📦 sing-box
      "type": "selector", // 类型为 selector，表示这是一个手动/默认选择器，可以在其 outbounds 列表中选择一个作为实际出口
      "tag": "📦 sing-box", // 选择器标签为“📦 sing-box”，被大量路由规则、DNS detour、HTTP 客户端引用
      "outbounds": [ // 该选择器可选的子出站列表
        "🟢 自动-测速", // 引用下面的 urltest 出站：快速测速自动选择
        "🔵 自动-稳定", // 引用下面的 urltest 出站：更稳定的自动选择（间隔更长、容忍度更高）
        "pkpk1" // 引用一个具体的代理节点；注意：当前配置中 pkpk1 尚未定义，你需要在“//节点配置”处填入实际的节点定义
      ], // 选择器的 outbounds 数组结束
      "default": "🟢 自动-测速" // 默认选择“🟢 自动-测速”作为出口；如果用户不手动切换，流量默认走这个 urltest
    }, // 📦 sing-box 选择器结束

    { // 自动测速出站 1：🟢 自动-测速
      "type": "urltest", // 类型为 urltest，定期对子出站进行延迟测试，并自动选择延迟最低的
      "tag": "🟢 自动-测速", // 标签为“🟢 自动-测速”
      "outbounds": [ // 参与测速的子出站列表
        "pkpk1" // 当前只有 pkpk1 一个节点参与测速
      ], // 子出站列表结束
      "url": "http://www.gstatic.com/generate_204", // 用于测速的 URL；generate_204 返回 204 无内容，响应小，适合测量延迟
      "interval": "3m0s", // 测速间隔为 3 分钟，即每 3 分钟后台重新测速并可能切换节点[reference:16]
      "tolerance": 30, // 容忍度为 30 毫秒；只有当另一个节点的延迟比当前节点低超过 30ms 时，才会切换，避免因微小抖动频繁切换[reference:17]
      "idle_timeout": "20m0s" // 空闲超时为 20 分钟；如果该 urltest 一段时间没有流量，可能进入空闲状态以减少后台测速开销
    }, // 🟢 自动-测速 结束

    { // 自动测速出站 2：🔵 自动-稳定
      "type": "urltest", // 同样是 urltest 类型
      "tag": "🔵 自动-稳定", // 标签为“🔵 自动-稳定”，从命名看更倾向于稳定性而非最快速度
      "outbounds": [ // 参与测速的子出站
        "pkpk1" // 同样目前只有 pkpk1
      ], // 子出站列表结束
      "url": "http://www.gstatic.com/generate_204", // 测速 URL 与上面相同
      "interval": "5m0s", // 测速间隔更长（5 分钟），减少测速频率，适合更看重稳定、不希望频繁切换的场景
      "tolerance": 50, // 容忍度更高（50 毫秒），意味着需要更大的延迟优势才会触发切换，进一步降低切换频率[reference:18]
      "idle_timeout": "30m0s" // 空闲超时 30 分钟，比“测速”版本更保守
    }, // 🔵 自动-稳定 结束

    { // Google 服务专用选择器
      "type": "selector", // 选择器类型
      "tag": "🧭 Google Services", // 标签为“🧭 Google Services”
      "outbounds": [ // 可选出口列表
        "📦 sing-box" // 只有“📦 sing-box”一个选项，意味着 Google 服务流量最终仍然走主选择器
      ], // outbounds 结束
      "default": "📦 sing-box" // 默认出口为“📦 sing-box”
    }, // 🧭 Google Services 结束

    { // Google FCM 推送专用选择器
      "type": "selector", // 选择器类型
      "tag": "📬 Google FCM", // 标签为“📬 Google FCM”
      "outbounds": [ // 可选出口
        "📦 sing-box", // 主代理选择器
        "🧭 Google Services" // 或者 Google 服务选择器（当前该选择器也只指向主选择器）
      ], // outbounds 结束
      "default": "📦 sing-box" // 默认走“📦 sing-box”
    }, // 📬 Google FCM 结束

    { // Apple 服务选择器
      "type": "selector", // 选择器类型
      "tag": "🍎 Apple", // 标签为“🍎 Apple”
      "outbounds": [ // 可选出口
        "DIRECT" // 只有直连选项，意味着 Apple 相关流量默认直连（不经过代理）
      ], // outbounds 结束
      "default": "DIRECT" // 默认直连
    }, // 🍎 Apple 结束

    { // 流媒体选择器
      "type": "selector", // 选择器类型
      "tag": "📺 StreamingME", // 标签为“📺 StreamingME”
      "outbounds": [ // 可选出口
        "📦 sing-box" // 走主代理选择器，即流媒体流量默认经过代理
      ], // outbounds 结束
      "default": "📦 sing-box" // 默认代理
    }, // 📺 StreamingME 结束

    { // 微软服务选择器
      "type": "selector", // 选择器类型
      "tag": "🪟 Microsoft", // 标签为“🪟 Microsoft”
      "outbounds": [ // 可选出口
        "DIRECT" // 只有直连，意味着微软相关流量默认不经过代理
      ], // outbounds 结束
      "default": "DIRECT" // 默认直连
    }, // 🪟 Microsoft 结束

    { // Telegram 选择器
      "type": "selector", // 选择器类型
      "tag": "📠 Telegram", // 标签为“📠 Telegram”
      "outbounds": [ // 可选出口
        "📦 sing-box" // 走主代理选择器，即 Telegram 流量默认经过代理
