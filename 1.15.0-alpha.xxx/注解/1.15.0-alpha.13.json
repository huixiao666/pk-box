        "type": "remote", // 远程规则集
        "tag": "gfw", // 标签为 gfw，对应 MetaCubeX 的 geosite gfw 集合
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/{tag}.srs", // URL 模板，{tag} 会被替换为 gfw
        "http_client": "rule-set-dl", // 同样通过代理下载
        "update_interval": "48h0m0s" // 每 48 小时更新一次
      }, // 规则集组 2 结束

      { // 规则集组 3：来自 SagerNet 的 sing-geosite
        "type": "remote", // 远程规则集
        "tag": [ // 标签列表
          "geosite-google", // Google 域名集合
          "geosite-android", // Android 域名集合
          "geosite-googlefcm", // Google FCM 域名集合
          "geosite-category-ads-all" // 广告类域名全集
        ], // tag 列表结束
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs", // URL 模板，逐个下载上述标签对应的 .srs
        "http_client": "rule-set-dl", // 通过 rule-set-dl 客户端下载
        "update_interval": "48h0m0s" // 每 48 小时更新一次
      } // 规则集组 3 结束

    ], // rule_set 列表结束

    "final": "🚦 FINAL", // 路由最终兜底出站：当所有路由规则都没有匹配时，使用“🚦 FINAL”选择器；不过本配置最后有一条无条件的 outbound 规则，因此实际上大部分流量会先被那条规则捕获；final 仍然是重要的保底配置
    "auto_detect_interface": true, // 自动检测系统默认网络接口，并将直连出站的连接绑定到该接口，防止在 TUN 模式下产生路由环路[reference:26]
    "default_domain_resolver": "pkpk-dns", // 当出站或规则没有显式指定 domain_resolver 时，默认使用 pkpk-dns（本地 DNS）来解析目标域名；这是一个合理的默认值，避免所有域名解析都依赖代理 DNS[reference:27]
    "default_http_client": "rule-set-dl" // 当 HTTP 请求（如规则集下载）没有显式指定 http_client 时，默认使用 rule-set-dl 客户端

  }, // route 模块结束

  "experimental": { // 实验性模块：包含缓存文件等持久化配置

    "cache_file": { // 磁盘缓存文件配置
      "enabled": true, // 启用磁盘缓存文件
      "path": "cache.db", // 缓存文件路径为 cache.db（当前工作目录下）
      "store_dns": true // 将 DNS 缓存持久化到磁盘；这是 1.14 引入的选项，重启 sing-box 后 DNS 缓存仍然有效，可减少冷启动时的 DNS 查询延迟[reference:28][reference:29]
    } // cache_file 配置结束

  } // experimental 模块结束

} // 根对象结束
